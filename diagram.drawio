        <mxCell id="rule" value="Unlocks require ownership.&#10;The two composite foreign keys on&#10;player_achievement ensure the achievement&#10;belongs to a game in the player’s library." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#253449;fontSize=14;verticalAlign=top;fontColor=#576477;" vertex="1" parent="1">
          <mxGeometry x="60" y="867" width="360" height="102" as="geometry" />
